<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>LazyTranslate</RootNamespace>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LazyTranslate</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>LazyTranslate.CatalogueBuilder</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
