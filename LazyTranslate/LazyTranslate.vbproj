<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LazyTranslate</RootNamespace>
    <UseWPF>true</UseWPF>

    <PackageId>LazyTranslate</PackageId>
    <Title>Lazy Translate</Title>
    <Description>Lazy Translation Library for WPF</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NuGet.Versioning" Version="7.9.0" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>LazyTranslate.CatalogueBuilder</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
