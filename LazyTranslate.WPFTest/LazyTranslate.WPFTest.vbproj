<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LazyTranslate.WPFTest</RootNamespace>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Resources\Localisation\de-DE.toml" />
    <None Remove="Resources\Localisation\en-AU.toml" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\Localisation\de-DE.toml" />
    <EmbeddedResource Include="Resources\Localisation\en-AU.toml" />
  </ItemGroup>

  <ItemGroup>
    <Import Include="System.Windows" />
    <Import Include="System.Windows.Controls" />
    <Import Include="System.Windows.Data" />
    <Import Include="System.Windows.Documents" />
    <Import Include="System.Windows.Input" />
    <Import Include="System.Windows.Media" />
    <Import Include="System.Windows.Media.Imaging" />
    <Import Include="System.Windows.Navigation" />
    <Import Include="System.Windows.Shapes" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LazyTranslate\LazyTranslate.vbproj" />
    <ProjectReference Include="..\LazyTranslate.CatalogueBuilder\LazyTranslate.CatalogueBuilder.vbproj" Condition="'$(Configuration)' == 'Debug'" />
  </ItemGroup>

</Project>
