<Window x:Class="MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:loc="clr-namespace:LazyTranslate;assembly=LazyTranslate"
        xmlns:local="clr-namespace:LazyTranslate.WPFTest"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="MainWindow"
        Width="800"
        Height="450"
        mc:Ignorable="d">
    <Grid>
        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" loc:L.Value="Hello World" />
        <Button Width="200" Height="50"
                Margin="0 150 0 0"
                loc:L.Value="Change Language" Click="Button_Click" />
        <TextBlock Width="200" Height="50"
                   Margin="0 250 0 0"
                   Text="{Binding MyName}" />
    </Grid>
</Window>
