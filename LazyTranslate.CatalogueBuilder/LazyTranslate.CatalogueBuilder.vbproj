<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>LazyTranslate</RootNamespace>

    <PackageId>LazyTranslate.CatalogueBuilder</PackageId>
    <Title>Lazy Translate Catalogue Builder</Title>
    <Description>Lazy Translate Catalogue Builder for creating and managing translation catalogues in DEBUG mode</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.VisualBasic" Version="5.9.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LazyTranslate\LazyTranslate.vbproj" />
  </ItemGroup>

</Project>
